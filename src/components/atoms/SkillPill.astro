---
interface Props {
  type: "programming" | "technology" | "concept";
}

const { type } = Astro.props;

const typeMap = {
  programming: {
    color: "bg-accent-200",
    darkColor: "dark:bg-accent-900/20",
  },
  technology: {
    color: "bg-purple-200",
    darkColor: "dark:bg-purple-900/20",
  },
  concept: {
    color: "bg-blue-200",
    darkColor: "dark:bg-blue-900/20",
  },
} as const;

const activeTheme = typeMap[type] ?? typeMap.programming;
---

<div
  class:list={[
    "w-22 h-22 leading-relaxed flex flex-col items-center justify-center text-6xl rounded-2xl",
    // activeTheme.color,
    // activeTheme.darkColor,
  ]}
>
  <slot />
</div>
