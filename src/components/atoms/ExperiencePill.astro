---
import ExperienceSkillPill from "./ExperienceSkillPill.astro";
---

<div class="glass-panel text-left m-auto my-8 reveal-on-scroll">
  <div class="m-auto py-6 mx-12">
    <h3 class="text-left w-auto">
      <slot name="company"> Example company </slot>
    </h3>
    <h2 class="inline-block text-2xl m-auto text-left w-auto">
      <slot name="position"> Example position </slot>
    </h2>
    <div class="inline-block lg:ml-8 my-2 lg:my-0">
      <slot name="tags">
        <ExperienceSkillPill>
          <wa-icon name="js" family="brands"></wa-icon>
        </ExperienceSkillPill>
      </slot>
    </div>
    <p class="text-sm">
      <slot name="years"> 2024 - currently </slot>
    </p>
    <p class="text-base my-4">
      <slot name="description"> Lorem ipsum </slot>
    </p>
  </div>
</div>
