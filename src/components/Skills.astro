            </SkillPill>
            <SkillPill type="technology">
              <NestJS fill="currentColor" />
              <div class="text-sm">NestJS</div>
            </SkillPill>
            <SkillPill type="technology">
              <Express fill="currentColor" />
              <div class="text-sm">Express.js</div>
            </SkillPill>
            <SkillPill type="technology">
