              <div class="text-sm">Python</div>
            </SkillPill>
            <SkillPill type="programming">
              <CSharp width="full" height="full" fill="currentColor" />
              <div class="text-sm">C#</div>
            </SkillPill>
            <SkillPill type="programming">
              <CPlusPlus width="full" height="full" fill="currentColor" />
              <div class="text-sm">C++</div>
            </SkillPill>
            <SkillPill type="programming">
              <C width="full" height="full" fill="currentColor" />
              <div class="text-sm">C</div>
            </SkillPill>
          </div>
        </div>
      </div>

      <div
