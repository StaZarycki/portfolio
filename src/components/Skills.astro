    <div class="text-center max-w-3xl mx-auto mb-20 reveal-on-scroll">
      <h2
        class="text-4xl md:text-5xl font-heading font-extrabold text-slate-900 dark:text-white mb-6"
      >
        Skills and technologies<br /><span
          class="text-slate-400 dark:text-slate-500"
          >used in my daily work.</span
        >
      </h2>
    </div>

    <!-- Bento Grid -->
    <div
