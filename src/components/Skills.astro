---
import SkillPill from "./atoms/SkillPill.astro";
import CSharp from "../content/images/csharp.svg";
import CPlusPlus from "../content/images/cpp.svg";
import C from "../content/images/C.svg";
import FastAPI from "../content/images/FastAPI.svg";
import NodeJS from "../content/images/Node.js.svg";
import NestJS from "../content/images/Nest.js.svg";
import Express from "../content/images/Express.svg";
import PostgreSQL from "../content/images/PostgresSQL.svg";
import MongoDB from "../content/images/MongoDB.svg";
import MariaDB from "../content/images/MariaDB.svg";
import Fastify from "../content/images/Fastify.svg";
import GraphQL from "../content/images/GraphQL.svg";
import RabbitMQ from "../content/images/RabbitMQ.svg";
---

<script>
  import "@awesome.me/webawesome/dist/components/icon/icon.js";
</script>

<section
  id="skills"
  class="py-32 bg-slate-50 dark:bg-[#0c0c0f] border-y border-slate-200 dark:border-slate-800 relative overflow-hidden"
>
  <!-- Subtle dark background glow -->
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-slate-200/50 via-transparent to-transparent dark:from-primary-900/10 dark:via-transparent dark:to-transparent"
  >
  </div>

